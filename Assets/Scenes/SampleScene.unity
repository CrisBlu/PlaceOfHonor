    - target: {fileID: 7872082951586697217, guid: a8cf2cedcc2a7d3408f5f31d15be421a, type: 3}
      propertyPath: S_playerDiags.Array.data[1].s_comment.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 7872082951586697217, guid: a8cf2cedcc2a7d3408f5f31d15be421a, type: 3}
      propertyPath: S_playerDiags.Array.data[2].s_comment.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 7872082951586697217, guid: a8cf2cedcc2a7d3408f5f31d15be421a, type: 3}
      propertyPath: S_playerDiags.Array.data[4].s_comment.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7872082951586697217, guid: a8cf2cedcc2a7d3408f5f31d15be421a, type: 3}
      propertyPath: S_playerDiags.Array.data[0].s_comment.Array.data[0].text
      value: "Here\u2019s what we found today. Another load of useless junk. "
      objectReference: {fileID: 0}
    - target: {fileID: 7872082951586697217, guid: a8cf2cedcc2a7d3408f5f31d15be421a, type: 3}
      propertyPath: S_playerDiags.Array.data[0].s_comment.Array.data[1].text
      value: "Wish they\u2019d stop sending us out there, I swear it\u2019s the same
        old dig site from yesterday."
      objectReference: {fileID: 0}
    - target: {fileID: 7872082951586697217, guid: a8cf2cedcc2a7d3408f5f31d15be421a, type: 3}
      propertyPath: S_playerDiags.Array.data[1].s_comment.Array.data[0].text
      value: I thought you liked getting out of the facility.
      objectReference: {fileID: 0}
    - target: {fileID: 7872082951586697217, guid: a8cf2cedcc2a7d3408f5f31d15be421a, type: 3}
      propertyPath: S_playerDiags.Array.data[1].s_comment.Array.data[1].text
      value: Might be junk to you, but some of this stuff could prove interesting
      objectReference: {fileID: 0}
    - target: {fileID: 7872082951586697217, guid: a8cf2cedcc2a7d3408f5f31d15be421a, type: 3}
      propertyPath: S_playerDiags.Array.data[2].s_comment.Array.data[0].text
      value: "No I mean, I\u2019m really sure we already finished this dig site.
        It\u2019s the same soil."
      objectReference: {fileID: 0}
    - target: {fileID: 7872082951586697217, guid: a8cf2cedcc2a7d3408f5f31d15be421a, type: 3}
      propertyPath: S_playerDiags.Array.data[2].s_comment.Array.data[1].text
      value: 'I don''t understand what they want with this site anyway. '
      objectReference: {fileID: 0}
    - target: {fileID: 7872082951586697217, guid: a8cf2cedcc2a7d3408f5f31d15be421a, type: 3}
      propertyPath: S_playerDiags.Array.data[3].s_comment.Array.data[0].text
      value: Interesting to them maybe
      objectReference: {fileID: 0}
    - target: {fileID: 7872082951586697217, guid: a8cf2cedcc2a7d3408f5f31d15be421a, type: 3}
      propertyPath: S_playerDiags.Array.data[3].s_comment.Array.data[1].text
      value: ' I doubt they''ll bother to let us know if we dig up anything valuable.'
      objectReference: {fileID: 0}
    - target: {fileID: 7872082951586697217, guid: a8cf2cedcc2a7d3408f5f31d15be421a, type: 3}
      propertyPath: S_playerDiags.Array.data[4].s_comment.Array.data[0].text
      value: Comment...
      objectReference: {fileID: 0}
    - target: {fileID: 7872082951586697217, guid: a8cf2cedcc2a7d3408f5f31d15be421a, type: 3}
